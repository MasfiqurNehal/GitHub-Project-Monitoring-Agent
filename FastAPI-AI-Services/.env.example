# ==============================================================================
# FASTAPI AI AGENT MICROSERVICE ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=8000
ENVIRONMENT=development
BACKEND_URL=http://localhost:5001/api

# ============================================================
# CHATBOT AI PROVIDER CONFIGURATION (Google Gemini AI)
# ============================================================
AI_PROVIDER=gemini
AI_BASE_URL=https://generativelanguage.googleapis.com
AI_API_KEY=YOUR_GEMINI_API_KEY_HERE
AI_MODEL=gemini-1.5-flash
AI_TIMEOUT_SECONDS=30.0

# ============================================================
# ENGINEERING AGENT LLM CONFIGURATION (Google Gemini AI)
# ============================================================
ENGINEERING_AGENT_LLM_PROVIDER=gemini
ENGINEERING_AGENT_LLM_BASE_URL=https://generativelanguage.googleapis.com
ENGINEERING_AGENT_LLM_API_KEY=YOUR_GEMINI_API_KEY_HERE
ENGINEERING_AGENT_LLM_MODEL=gemini-1.5-flash

ENGINEERING_AGENT_LLM_TIMEOUT=45
ENGINEERING_AGENT_LLM_MAX_RETRIES=2

# Context Management Settings
MAX_CONTEXT_MESSAGES=10
MAX_CONTEXT_TOKENS=3000

# Database Configuration (Neon PostgreSQL)
DATABASE_URL=

# Security & Authentication
JWT_SECRET=super-secret-jwt-key-github-monitoring-agent
