# ==============================================================================
# GITHUB PROJECT MONITORING AGENT - BACKEND ENVIRONMENT EXAMPLE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION SERVER CONFIGURATION
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (NEON CLOUD POSTGRESQL & PRISMA)
# Replace with your actual Neon PostgreSQL connection string from https://neon.tech
# Note: Ensure sslmode=require is included for Neon DB connections
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ------------------------------------------------------------------------------
# 3. GITHUB APP AUTHENTICATION & INTEGRATION CREDENTIALS
# Required for production GitHub App authentication & installation tokens
# ------------------------------------------------------------------------------
GITHUB_APP_ID=123456
GITHUB_CLIENT_ID=Iv1.sample_client_id
GITHUB_CLIENT_SECRET=sample_client_secret_key
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_github_app_private_key_pem_here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET=github_monitoring_webhook_secret_key
GITHUB_API_URL=https://api.github.com
GITHUB_API_VERSION=2022-11-28
GITHUB_TOKEN=optional_fallback_pat_token

# ------------------------------------------------------------------------------
# 4. SECURITY & ENCRYPTION
# ------------------------------------------------------------------------------
JWT_SECRET=super-secret-jwt-key-change-in-production
ENCRYPTION_KEY=32-character-secret-encryption-key!
