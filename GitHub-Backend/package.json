{
  "name": "github-monitoring-backend",
  "version": "1.0.0",
  "description": "Backend engine for GitHub Project Monitoring AI Agent",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx database/migrate.ts",
    "db:clean": "tsx database/clean.ts",
    "db:reset": "tsx database/reset.ts",
    "db:seed": "tsx database/seed.ts",
    "logs": "powershell -Command \"Get-Content -Path logs/logger.txt -Wait -Tail 50\""
  },
  "dependencies": {
    "@google/generative-ai": "^0.11.4",
    "@octokit/auth-app": "^8.3.1",
    "@octokit/rest": "^20.1.0",
    "@prisma/client": "^5.14.0",
    "@types/pg": "^8.23.1",
    "bullmq": "^5.7.12",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.4.1",
    "morgan": "^1.10.0",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.12.12",
    "prisma": "^5.14.0",
    "tsx": "^4.10.5",
    "typescript": "^5.4.5"
  }
}
